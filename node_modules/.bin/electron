#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/ubuntu/Odonto-novo-sorriso/Odonto-novo-sorriso/node_modules/.pnpm/electron@42.0.0/node_modules/electron/node_modules:/home/ubuntu/Odonto-novo-sorriso/Odonto-novo-sorriso/node_modules/.pnpm/electron@42.0.0/node_modules:/home/ubuntu/Odonto-novo-sorriso/Odonto-novo-sorriso/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/ubuntu/Odonto-novo-sorriso/Odonto-novo-sorriso/node_modules/.pnpm/electron@42.0.0/node_modules/electron/node_modules:/home/ubuntu/Odonto-novo-sorriso/Odonto-novo-sorriso/node_modules/.pnpm/electron@42.0.0/node_modules:/home/ubuntu/Odonto-novo-sorriso/Odonto-novo-sorriso/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/electron@42.0.0/node_modules/electron/cli.js" "$@"
else
  exec node  "$basedir/../.pnpm/electron@42.0.0/node_modules/electron/cli.js" "$@"
fi
